# 你的阿里百炼 API Key（必填，或改为在客户端 OpenAI SDK 的 api_key 里传入）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：本服务的访问密钥。设置后，客户端必须带 Authorization: Bearer <SERVER_API_KEY>
# 不设置则服务无鉴权（仅建议在本地/内网使用）
SERVER_API_KEY=

# 可选：国际站改为 https://dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 可选：/v1/models 返回的模型列表（逗号分隔）。
# 留空 = 自动从上游官方 models 接口拉取并过滤出生图模型（推荐，无需配置）
IMAGE_MODELS=

# 可选：优先使用异步任务接口（仅对支持异步的模型生效，如 wan2.7 系列）。
# 默认 false 用同步接口（更快）；设为 true 时若模型不支持异步会自动回退同步
PREFER_ASYNC=false
